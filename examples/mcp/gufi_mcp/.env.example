# Copy to .env and adjust paths for your environment.

GUFI_INDEXES_ROOT=/path/to/gufi/local/search/
GUFI_EXECUTABLE=/path/to/gufi/local/bin/gufi_query
GUFI_SERVER_PREFIX=/path/to/gufi/local
GUFI_CLIENT_BIN=/path/to/gufi/local/client-bin
GUFI_CLIENT_CONFIG=/path/to/gufi/local/etc/GUFI/client.config
GUFI_SSH_IDENTITY=~/.ssh/gufi_local
DEFAULT_INDEX=notes
SCHEMAFILE=./schemas.json
GUFIVTLIB=/path/to/gufi_vt.so
REMOTEHOST=127.0.0.1
MCPTRANSPORT=streamable-http
MCPSRVHOST=127.0.0.1
MCPSRVPORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
GUFI_PLOT_DIR=./plots
