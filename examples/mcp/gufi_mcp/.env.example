SCHEMAFILE='./gufi_schemas.txt'
REMOTEHOST='<remote uri>'
MCPTRANSPORT='streamable-http'
MCPSRVHOST='127.0.0.1'
MCPSRVPORT=8000
# Path to gufi_vt shared library (.so). The server strips .so for sqlite3.load_extension.
GUFIVTLIB='path/to/gufi_vt.so'
# For sql_file_index / aggregate_sql_query, libsqlite3-pcre must be on LD_LIBRARY_PATH when starting the server.
GUFI_INDEX_ROOT = '/path/to/gufi_indexes/'
GUFI_QUERY = '/path/to/gufi_query'
GUFI_MCP_EVENT_LOG = './logs/server/'