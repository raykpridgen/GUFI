SCHEMAFILE='./gufi_schemas.txt'
# Optional: run gufi_query on another host through gufi_vt (GUFI_INDEX_ROOT is then a path on that host)
# GUFI_REMOTE_CMD='ssh'
# GUFI_REMOTE_ARGS='user@gufi-host'
MCPTRANSPORT='streamable-http'
MCPSRVHOST='127.0.0.1'
MCPSRVPORT=8000
GUFIVTLIB='path/to/gufi_vt'
GUFI_INDEX_ROOT = '/path/to/gufi_indexes/'
GUFI_QUERY = '/path/to/gufi_query'
GUFI_MCP_EVENT_LOG = './logs/server/'